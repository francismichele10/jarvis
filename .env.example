OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WAKE_WORD=jarvis

# Speech output. 145 is a slightly slower, calmer starting point.
VOICE_RATE=145
VOICE_VOLUME=1.0

# Optional: choose an installed Windows voice by part of its name or exact voice ID.
# Leave both blank to let JARVIS choose a preferred English voice automatically.
VOICE_NAME=
VOICE_ID=

# Optional extracted Vosk model folder:
# VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
